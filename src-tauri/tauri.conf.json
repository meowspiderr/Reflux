{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflux",
  "mainBinaryName": "Reflux",
  "version": "1.0.0",
  "identifier": "com.reflux.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reflux",
        "width": 540,
        "height": 660,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0A0A0B",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "$HOME/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$MUSIC/**",
          "$AUDIO/**",
          "$VIDEO/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "publisher": "Reflux",
    "copyright": "© 2026 Reflux",
    "shortDescription": "A simple audio editor for your computer.",
    "longDescription": "Reflux lets you trim, boost, fade, and save audio without an account or an internet connection. Save as MP3, WAV, FLAC, or M4A. Everything stays on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Reflux"
      }
    }
  }
}
